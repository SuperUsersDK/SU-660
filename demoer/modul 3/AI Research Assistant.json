    {
      "parameters": {
        "jsCode": "const hits = $json.query?.search || [];\nconst webContext = hits.length\n  ? hits.map((hit, index) => `${index + 1}. ${hit.title}: ${String(hit.snippet || '').replace(/<[^>]+>/g, '')}`).join('\\n')\n  : 'Ingen webresultater fundet.';\n\nreturn [{ json: { webContext } }];"
      },
      "id": "82ff96f1-c75d-45a7-8b12-2012551e9b61",
      "name": "Format Web Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        40
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Du er en research-assistent.\n\nBrugerens spørgsmål:\n{{ $('Chat Trigger').first().json.chatInput }}\n\nInternt svar fra vores dokumenter:\n{{ $('Internal RAG Answer').first().json.text || $('Internal RAG Answer').first().json.answer || 'Intet internt svar.' }}\n\nEksterne webfund:\n{{ $json.webContext }}\n\nSkriv et samlet svar i tre korte dele:\n1. Hvad siger vores dokumenter?\n2. Hvad siger de eksterne kilder?\n3. Kort samlet vurdering.\n\nHvis de to kilder er i konflikt, så sig det tydeligt.",
        "options": {}
      },
