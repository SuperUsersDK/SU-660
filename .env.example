# Kopiér til .env i repository-roden og udfyld værdierne.
# Demoerne indlæser .env med override=True, så værdier her vinder over
# miljøvariabler sat i terminalen.

# --- OpenAI -------------------------------------------------------------------

# Påkrævet til chat-, RAG- og agent-demoerne samt templates/boilerplate.py.
# Chunking-demoer, øvelser og foto-demoet (CLIP kører lokalt) kræver ingen nøgle.
OPENAI_API_KEY=

# Chat-model til alle Python-demoer (billig standard).
OPENAI_MODEL=gpt-6-luna

# Embedding-model til agent-demoerne i modul 3.
OPENAI_EMBED_MODEL=text-embedding-3-small

# Embedding-model til RAG-demoet i demoer/modul 2/big_demo.
EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant -------------------------------------------------------------------

# Skal matche QDRANT__SERVICE__API_KEY i docker-compose.yml.
QDRANT_API_KEY=hemmelighed

# Adresse til Qdrant fra Python-demoerne (n8n bruger http://qdrant:6333).
QDRANT_URL=http://localhost:6333

# Collection til RAG-demoet i demoer/modul 2/big_demo.
QDRANT_COLLECTION=rag_data

# --- Chunking-laboratoriet (modul 2) ------------------------------------------

# "local" (standard) bruger intfloat/multilingual-e5-small offline; "openai" bruger
# OPENAI_EMBED_MODEL og kræver OPENAI_API_KEY.
CHUNK_LAB_EMBEDDINGS=local

# --- Foto-demo (modul 3) ------------------------------------------------------

# CLIP-model fra Hugging Face; hentes ved første kørsel.
IMAGE_EMBED_MODEL=openai/clip-vit-base-patch32

# Zero-shot tags: "eksempler" passer til fetch_sample_photos.py (10 kategorier),
# "dykning" til en samling dykkerbilleder. Kør tag_photos.py efter et skift.
PHOTO_LABEL_SET=eksempler

# Model til siden "Sammenlign modeller". Ingest den med
# ingest_photos.py --model <navn>; den store model fylder ca. 1,7 GB.
COMPARE_IMAGE_EMBED_MODEL=openai/clip-vit-large-patch14

# --- Tokenizer-cache (valgfri) ------------------------------------------------

# Standard er .cache/tiktoken/ i repository-roden. Brug samme værdi ved
# tools/warmup_tokenizers.py og når demoerne køres offline.
# TIKTOKEN_CACHE_DIR=.cache/tiktoken
